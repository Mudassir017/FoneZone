{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "chmod +x mvnw && ./mvnw -B -DskipTests clean package"
  },
  "deploy": {
    "startCommand": "java -XX:MaxRAMPercentage=75 -jar target/mobinest-api-0.0.1-SNAPSHOT.jar",
    "healthcheckPath": "/actuator/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}
