# Copy this file to .env.local and fill in YOUR Clerk publishable key (Clerk Dashboard -> API keys).
# Never commit .env.local. Only VITE_-prefixed variables reach the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Optional: API origin for production builds (dev uses the Vite proxy /api -> http://localhost:8080)
# VITE_API_BASE_URL=https://api.example.com
